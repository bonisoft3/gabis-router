{
  "app": "GBRouter",
  "carriers": {
    "types": {
      "string": { "pg": "text", "column": "plain", "subset": true, "base": ["text"], "json": "string", "order": "text", "beyond": [] },
      "int32": { "pg": "integer", "column": "plain", "subset": true, "base": ["int4"], "json": "number", "min": -2147483648, "max": 2147483647, "order": "number", "beyond": [] },
      "int64": { "pg": "bigint", "column": "domain", "subset": false, "sql": "portable_int64", "base": ["int8"], "json": "string", "order": "integer", "beyond": [] },
      "timestamp": { "pg": "timestamptz", "column": "domain", "subset": false, "sql": "portable_timestamp", "base": ["timestamptz"], "json": "string", "order": "text", "beyond": [] },
      "date": { "pg": "date", "column": "checked", "subset": true, "base": ["date"], "json": "string", "order": "text", "beyond": [] },
      "duration": { "pg": "interval", "column": "domain", "subset": false, "sql": "portable_duration", "base": ["interval"], "json": "string", "order": "duration", "beyond": [] },
      "decimal": { "pg": "numeric", "column": "domain", "subset": false, "base": ["numeric"], "json": "string", "order": "decimal", "beyond": ["decimal-profile"] },
      "double": { "pg": "double precision", "column": "checked", "subset": true, "base": ["float8"], "json": "number", "order": "number", "beyond": [] },
      "uuid": { "pg": "uuid", "column": "plain", "subset": true, "base": ["uuid"], "json": "string", "order": "text", "beyond": [] }
    },
    "aliases": { "text": "string", "int": "int32", "bigint": "int64", "timestamptz": "timestamp", "tsvector": "string" }
  },
  "floors": {
    "touch": 24
  },
  "local": {
    "ui_state": "tab",
    "profile_slot": "tab",
    "search_result": "tab",
    "waypoint": "tab",
    "avoid_area": "tab",
    "route_bar": "tab"
  },
  "seed": {
    "ui_state": [
      {
        "id": "main",
        "controls_class": "",
        "profile_badge": "Low Traffic",
        "hide_offline_pill": "true",
        "collapse_btn_title": "Collapse controls",
        "collapse_btn_label": "Collapse panel",
        "profile_label_text": "Profile",
        "profile_tooltip": "Paved roads, avoids heavy traffic, balanced climbing. Profiles score every road segment by surface, traffic, hills, and cycle infrastructure. Add up to 3 profiles to compare routes side by side.",
        "hide_add_profile": "false",
        "search_placeholder": "Search place, postcode, or lat, lon...",
        "hide_clear_search": "true",
        "hide_search_results": "true",
        "hide_search_status": "true",
        "search_status": "",
        "disable_undo": "true",
        "disable_redo": "true",
        "disable_reverse": "true",
        "disable_clear": "true",
        "hide_avoid_section": "true",
        "hide_avoid_header": "true",
        "avoid_header_title": "Avoid Areas (0)",
        "status_class": "status-bar",
        "hide_status_bar": "false",
        "hide_status_spinner": "true",
        "status_text": "Click on the map or search to set start and end points.",
        "disable_share": "true",
        "disable_export": "true",
        "share_btn_text": "Share",
        "route_info_class": "",
        "hide_route_info": "true",
        "hide_settings_modal": "true",
        "offline_mode_badge_class": "offline-badge badge-online",
        "offline_mode_badge_text": "Online",
        "offline_card_badge_class": "offline-mini-badge badge-missing",
        "offline_card_badge_text": "Not Downloaded",
        "offline_card_desc": "Download UK routing data and map tiles to enable offline mode.",
        "hide_download_card": "true",
        "download_msg": "",
        "download_pct": "0%",
        "download_progress_style": "width: 0%",
        "hide_btn_download": "false",
        "disable_btn_download": "false",
        "btn_download_text": "Download UK Data",
        "hide_btn_delete": "true",
        "disable_btn_update": "false",
        "btn_update_text": "Clear cache",
        "snapshot_date_text": "Not cached",
        "tf_key_status": "Default key active for OpenCycleMap.",
        "hide_about_modal": "true",
        "units": "metric",
        "theme": "auto",
        "offline_mode": "",
        "thunderforest_key": "",
        "search_query": "",
        "host_cmd": ""
      }
    ],
    "profile_slot": [
      {
        "id": "slot_0",
        "slot_idx": 0,
        "select_id": "profile-select",
        "remove_btn_id": "btn-remove-profile-0",
        "profile": "fastbike-lowtraffic",
        "label": "Fastbike Low Traffic",
        "summary": "Paved roads, avoids heavy traffic, balanced climbing.",
        "color_line": "#3b82f6",
        "color_name": "Blue",
        "dot_style": "background-color: #3b82f6",
        "dot_title": "Route 1 (Blue)",
        "hide_compare_chrome": "true"
      }
    ],
    "search_result": [],
    "waypoint": [],
    "avoid_area": [],
    "route_bar": []
  },
  "server": false,
  "hostDom": {
    "router-host": {
      "src": "shell/hatches/router-host.js",
      "targets": [
        "#map",
        "#router-ui",
        "#controls",
        "#route-info",
        "#settings-modal",
        "#about-modal"
      ],
      "note": "MapLibre GL canvas, WASM BRouter routing engine, OPFS offline bundle manager, and MCP bridge"
    }
  },
  "routes": [
    {
      "path": "/",
      "screen": "router",
      "nav": {
        "key": "nav_router",
        "label": "GBRouter",
        "strip": false
      },
      "hatches": [
        "router-host"
      ],
      "files": {
        "html": "shell/screens/router.html",
        "css": "shell/screens/router.css",
        "handlers": [
          "shell/handlers/ui-action.js"
        ],
        "renderers": [
          "shell/renderers/elevation-chart.js",
          "shell/renderers/surface-breakdown.js"
        ],
        "adapters": [],
        "shared": []
      },
      "ssr": "spa",
      "states": [
        "populated",
        "form-submit",
        "success"
      ]
    }
  ],
  "tables": [],
  "schema": {
    "ui_state": {
      "durability": "tab",
      "fields": [
        { "name": "id", "pk": true, "type": "string", "required": true }
      ]
    },
    "profile_slot": {
      "durability": "tab",
      "fields": [
        { "name": "id", "pk": true, "type": "string", "required": true },
        { "name": "slot_idx", "type": "int32", "required": true }
      ]
    },
    "search_result": {
      "durability": "tab",
      "fields": [
        { "name": "id", "pk": true, "type": "string", "required": true },
        { "name": "idx", "type": "int32", "required": true },
        { "name": "lat", "type": "double" },
        { "name": "lon", "type": "double" },
        { "name": "name", "type": "string" }
      ]
    },
    "waypoint": {
      "durability": "tab",
      "fields": [
        { "name": "id", "pk": true, "type": "string", "required": true },
        { "name": "idx", "type": "int32", "required": true },
        { "name": "lat", "type": "double" },
        { "name": "lon", "type": "double" },
        { "name": "name", "type": "string" },
        { "name": "is_geocoding", "type": "string" },
        { "name": "is_editing", "type": "string" }
      ]
    },
    "avoid_area": {
      "durability": "tab",
      "fields": [
        { "name": "id", "pk": true, "type": "string", "required": true },
        { "name": "idx", "type": "int32", "required": true },
        { "name": "lat", "type": "double" },
        { "name": "lon", "type": "double" },
        { "name": "radius", "type": "double" },
        { "name": "weight", "type": "string" }
      ]
    },
    "route_bar": {
      "durability": "tab",
      "fields": [
        { "name": "id", "pk": true, "type": "string", "required": true },
        { "name": "slot_idx", "type": "int32", "required": true }
      ]
    }
  }
}
